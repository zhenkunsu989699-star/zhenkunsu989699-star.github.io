---
import Base from '../../layouts/Base.astro';
import { getNotes } from '../../lib/papers';
const notes = await getNotes();
---
<Base title="随笔 Notes" description="读书笔记、政策评论与学术见闻">
  <header class="container narrow head">
    <p class="eyebrow" lang="en" data-reveal>Notes</p>
    <h1 class="display" data-reveal style="--d:80ms">随笔</h1>
    <p class="lead" data-reveal style="--d:160ms">读书笔记、政策评论与学术见闻。</p>
  </header>

  <section class="container narrow list">
    {notes.length ? (
      <ul class="notes">
        {notes.map((n, i) => (
          <li data-reveal style={`--d:${i * 70}ms`}>
            <a class="note card lift" href={`/notes/${n.id}/`}>
              <time>{n.data.date.toISOString().slice(0, 10)}{n.data.draft && <span class="draft">草稿 · 仅本地可见</span>}</time>
              <h2>{n.data.title}</h2>
              {n.data.summary && <p>{n.data.summary}</p>}
              <span class="link-arrow">阅读全文</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <div class="empty card" data-reveal>
        <svg viewBox="0 0 48 48" width="48" height="48" aria-hidden="true"><path d="M12 6h18l8 8v28H12z M30 6v8h8 M18 24h14 M18 31h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/></svg>
        <h2>文章整理中</h2>
        <p>第一篇随笔即将发布，敬请期待。</p>
      </div>
    )}
  </section>
</Base>
<style>
  .head { padding-top: calc(var(--nav-h) + clamp(56px, 9vw, 112px)); padding-bottom: 48px; text-align: center; }
  .head .display { margin-top: 8px; letter-spacing: .12em; }
  .head .lead { margin-top: 16px; }
  .list { padding-bottom: clamp(80px, 10vw, 128px); }
  .notes { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .note { display: block; padding: 32px; color: var(--text); text-decoration: none !important; }
  time { display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--text-3); font-variant-numeric: tabular-nums; }
  .draft { padding: 2px 8px; border-radius: 999px; background: rgba(255, 159, 10, .15); color: #c77700; font-size: 12px; font-weight: 600; }
  .note h2 { margin-top: 10px; font-size: 24px; line-height: 1.3; }
  .note p { margin-top: 10px; color: var(--text-2); }
  .note .link-arrow { display: inline-flex; margin-top: 16px; color: var(--accent-text); }
  .empty { display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 64px 24px; text-align: center; color: var(--text-3); }
  .empty h2 { margin-top: 8px; font-size: 22px; color: var(--text); }
</style>
