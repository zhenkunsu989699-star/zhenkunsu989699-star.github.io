---
import Base from '../layouts/Base.astro';
---
<Base title="页面未找到">
  <section class="nf container">
    <p class="code gradient-text">404</p>
    <h1 class="title">这个页面不存在。</h1>
    <p class="muted">Page not found.</p>
    <p class="act"><a class="btn btn-primary" href="/">返回首页</a></p>
  </section>
</Base>
<style>
  .nf { min-height: 80svh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 12px; padding-top: var(--nav-h); }
  .code { font-size: clamp(96px, 18vw, 180px); font-weight: 800; letter-spacing: -0.06em; line-height: 1; }
  .act { margin-top: 20px; }
</style>
