---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import beijing from '../assets/stock/beijing.jpg';
import avatar from '../assets/photos/avatar.jpg';

const links = site.links.filter((l) => l.href);
const education = [
  { when: '2026 年至今', school: '对外经济贸易大学', dept: '国际经济贸易学院', degree: '博士研究生', en: 'PhD Student, UIBE' },
  { when: '2023—2026 年', school: '山东师范大学', dept: '经济学院', degree: '经济学硕士 · 理论经济学', en: 'M.Econ., Shandong Normal University', advisor: '导师：宁静波教授' },
];
// 线性图标（24×24 路径）：天平、文档、建筑、链条、图表
const icons = [
  'M12 3v18M7 21h10M5 7h14M5 7l-3 6a3 3 0 0 0 6 0L5 7Zm14 0-3 6a3 3 0 0 0 6 0l-3-6Z',
  'M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h6',
  'M3 21h18M5 21V10M19 21V10M9 21v-7M15 21v-7M2 10l10-6 10 6z',
  'M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1',
  'M4 20V4M4 20h16M8 16v-4M12 16V8M16 16v-6',
];
---
<Base title="关于 About" description={`${site.name}的简介、教育经历与联系方式`} overlayNav>
  <section class="hero">
    <div class="hero-img" data-parallax="0.2">
      <Image src={beijing} alt="北京城市夜景" widths={[800, 1400, 2200]} sizes="100vw" loading="eager" />
    </div>
    <div class="hero-shade"></div>
    <div class="container hero-body">
      <p class="eyebrow" lang="en" data-reveal>About · Beijing</p>
      <h1 class="display" data-reveal style="--d:80ms">关于我</h1>
    </div>
  </section>

  <section class="container profile-wrap">
    <div class="profile card" data-reveal="scale">
      <div class="avatar">
        <Image src={avatar} alt="苏振坤证件照" widths={[160, 320]} sizes="160px" loading="eager" />
      </div>
      <div class="pinfo">
        <h2>{site.name} <span lang="en">{site.nameEn}</span></h2>
        <p>{site.title}</p>
        <p class="en" lang="en">{site.titleEn}</p>
      </div>
      <div class="pactions">
        <a class="btn btn-primary" href={`mailto:${site.email}`}>发送邮件</a>
        <a class="btn btn-ghost" href="/research/">查看研究</a>
      </div>
    </div>
  </section>

  <section class="section bio-section">
    <div class="container narrow">
      <p class="eyebrow" data-reveal>简介<span lang="en">Biography</span></p>
      <p class="bio-zh" data-reveal style="--d:80ms">
        苏振坤，对外经济贸易大学国际经济贸易学院博士研究生，硕士毕业于山东师范大学经济学院。研究兴趣为法经济学、公司信息披露与制度经济学，关注司法改革、制度型开放与数据要素市场化等制度变迁对企业行为与产业链韧性的影响。研究成果发表于 <em lang="en">Economics &amp; Politics</em>、《产业经济研究》、《经济与管理评论》等期刊。
      </p>
      <p class="bio-en" lang="en" data-reveal style="--d:140ms">
        Zhenkun Su is a PhD student at the School of International Trade and Economics, University of International Business and Economics (UIBE), and holds a master's degree in economics from Shandong Normal University. The research lies at the intersection of law and economics and corporate finance, studying how judicial reform, institutional opening-up and data-market reforms shape corporate disclosure, innovation and supply-chain resilience.
      </p>
    </div>
  </section>

  <section class="section alt">
    <div class="container narrow">
      <header class="section-head">
        <p class="eyebrow" data-reveal>教育经历<span lang="en">Education</span></p>
        <h2 class="headline" data-reveal style="--d:80ms">求学之路</h2>
      </header>
      <ol class="timeline">
        {education.map((e, i) => (
          <li data-reveal style={`--d:${i * 120}ms`}>
            <span class="node" aria-hidden="true"></span>
            <div class="tl-card card">
              <p class="when">{e.when}</p>
              <h3>{e.school}<span>{e.dept}</span></h3>
              <p class="degree">{e.degree}</p>
              <p class="tl-en" lang="en">{e.en}</p>
              {e.advisor && <p class="tl-adv">{e.advisor}</p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow" data-reveal>研究兴趣<span lang="en">Interests</span></p>
        <h2 class="headline" data-reveal style="--d:80ms">我关心的问题</h2>
      </header>
      <ul class="interests">
        {site.interests.map((t, i) => (
          <li class="icard card lift" data-reveal style={`--d:${i * 70}ms`}>
            <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24"><path d={icons[i]} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
            <h3>{t}</h3>
            <p lang="en">{site.interestsEn[i]}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section alt">
    <div class="container narrow">
      <header class="section-head">
        <p class="eyebrow" data-reveal>联系<span lang="en">Contact</span></p>
        <h2 class="headline" data-reveal style="--d:80ms">保持联系</h2>
      </header>
      <div class="contacts">
        <a class="ccard card lift" href={`mailto:${site.email}`} data-reveal>
          <span class="cico" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22"><rect x="3" y="5" width="18" height="14" rx="3" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m4 7 8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
          </span>
          <span class="clabel">电子邮箱</span>
          <span class="cval" lang="en">{site.email}</span>
        </a>
        <div class="ccard card" data-reveal style="--d:80ms">
          <span class="cico" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="9.5" r="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
          </span>
          <span class="clabel">单位</span>
          <span class="cval">对外经济贸易大学 国际经济贸易学院 · 北京</span>
        </div>
        {links.map((l, i) => (
          <a class="ccard card lift" href={l.href} target="_blank" rel="noopener" data-reveal style={`--d:${(i + 2) * 80}ms`}>
            <span class="cico" aria-hidden="true">↗</span>
            <span class="clabel" lang="en">{l.label}</span>
            <span class="cval">{l.href.replace(/^https?:\/\//, '')}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; height: min(64svh, 560px); min-height: 400px; overflow: hidden; color: #fff; display: flex; align-items: flex-end; background: #0b0b0c; }
  .hero-img { position: absolute; inset: -12% 0; will-change: transform; }
  .hero-img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .hero-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.5) 0%, rgba(0,0,0,.1) 45%, rgba(0,0,0,.7) 100%); }
  .hero-body { position: relative; padding-bottom: 120px; }
  .hero .eyebrow { color: rgba(255,255,255,.75); }
  .hero .display { margin-top: 8px; letter-spacing: .12em; }

  .profile-wrap { position: relative; z-index: 2; margin-top: -72px; }
  .profile { display: flex; align-items: center; gap: 28px; padding: 28px 32px; border-radius: var(--r-lg); box-shadow: var(--shadow-lg); }
  .avatar { flex: none; width: 112px; height: 112px; border-radius: 50%; overflow: hidden; box-shadow: 0 0 0 4px var(--surface), 0 0 0 5px var(--line); }
  .avatar :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .pinfo { flex: 1; min-width: 0; }
  .pinfo h2 { font-size: 30px; font-weight: 700; letter-spacing: .08em; }
  .pinfo h2 span { font-size: 18px; font-weight: 500; color: var(--text-3); margin-left: 8px; }
  .pinfo p { margin-top: 6px; font-size: 15px; color: var(--text-2); }
  .pinfo .en { margin-top: 2px; font-size: 13px; color: var(--text-3); }
  .pactions { display: flex; gap: 10px; flex-wrap: wrap; }
  @media (max-width: 760px) {
    .profile { flex-direction: column; text-align: center; padding: 28px 22px; }
    .profile-wrap { margin-top: -56px; }
    .pactions { justify-content: center; }
  }

  .bio-section { padding-top: clamp(64px, 9vw, 112px); }
  .bio-zh { margin-top: 20px; font-size: clamp(20px, 2.4vw, 26px); line-height: 1.85; font-weight: 400; letter-spacing: .02em; text-align: justify; }
  .bio-en { margin-top: 28px; font-size: 17px; line-height: 1.7; color: var(--text-2); }

  .timeline { list-style: none; margin: 0; padding: 0 0 0 28px; position: relative; }
  .timeline::before { content: ""; position: absolute; left: 7px; top: 12px; bottom: 12px; width: 2px; border-radius: 2px; background: linear-gradient(var(--accent), color-mix(in srgb, var(--accent) 10%, transparent)); }
  .timeline li { position: relative; }
  .timeline li + li { margin-top: 20px; }
  .node { position: absolute; left: -28px; top: 30px; width: 16px; height: 16px; border-radius: 50%; background: var(--surface); box-shadow: inset 0 0 0 4px var(--accent); }
  .tl-card { padding: 24px 28px; }
  .when { font-size: 14px; font-weight: 600; color: var(--accent-text); font-variant-numeric: tabular-nums; }
  .tl-card h3 { margin-top: 8px; font-size: 22px; font-weight: 700; }
  .tl-card h3 span { font-size: 16px; font-weight: 500; color: var(--text-2); margin-left: 10px; }
  .degree { margin-top: 8px; font-size: 16px; }
  .tl-en { margin-top: 4px; font-size: 14px; color: var(--text-3); }
  .tl-adv { margin-top: 2px; font-size: 14px; color: var(--text-2); }

  .interests { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 16px; }
  @media (max-width: 400px) { .icard { padding: 22px 18px; } }
  .icard { padding: 28px 24px; }
  .ico { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 14px; background: color-mix(in srgb, var(--accent) 10%, transparent); color: var(--accent-text); }
  .icard h3 { margin-top: 18px; font-size: 19px; }
  .icard p { margin-top: 6px; font-size: 14px; color: var(--text-3); }

  .contacts { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
  .ccard { display: flex; flex-direction: column; gap: 6px; padding: 28px; color: var(--text); text-decoration: none !important; }
  .cico { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: color-mix(in srgb, var(--accent) 12%, transparent); color: var(--accent-text); margin-bottom: 10px; font-size: 18px; }
  .clabel { font-size: 13px; color: var(--text-3); }
  .cval { font-size: 17px; font-weight: 500; overflow-wrap: anywhere; }
</style>
