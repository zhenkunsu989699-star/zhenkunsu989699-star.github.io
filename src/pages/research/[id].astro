---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { site, themes } from '../../data/site';
import { getPapers, venueLine, citation } from '../../lib/papers';
import judicial from '../../assets/stock/judicial.jpg';
import port from '../../assets/stock/port.jpg';
import data from '../../assets/stock/data.jpg';

export async function getStaticPaths() {
  const papers = await getPapers();
  return papers.map((paper) => ({ params: { id: paper.id }, props: { paper, all: papers } }));
}
const { paper, all } = Astro.props;
const p = paper.data;
const cite = citation(p);
const pdfUrl = p.pdf ? new URL(p.pdf, Astro.site).href : undefined;
const pubDate = p.date.toISOString().slice(0, 10).replaceAll('-', '/');
const theme = themes.find((t) => t.paper === paper.id);
const banner = theme ? { judicial, port, data }[theme.key] : undefined;
const others = all.filter((x) => x.id !== paper.id).slice(0, 3);
const statusLabel = { published: '期刊论文', working: '工作论文', thesis: '学位论文' }[p.status];
---
<Base title={p.title} description={p.abstract.slice(0, 150)}>
  <Fragment slot="head">
    {/* Google Scholar 收录所需的 Highwire Press 元数据 */}
    <meta name="citation_title" content={p.title} />
    {p.authors.map((a) => <meta name="citation_author" content={a} />)}
    <meta name="citation_publication_date" content={pubDate} />
    {p.status === 'thesis'
      ? <meta name="citation_dissertation_institution" content="山东师范大学" />
      : <meta name="citation_journal_title" content={p.venue} />}
    {p.volume && <meta name="citation_volume" content={p.volume} />}
    {p.issue && <meta name="citation_issue" content={p.issue} />}
    {p.pages && <meta name="citation_firstpage" content={p.pages.split('-')[0]} />}
    {p.pages && <meta name="citation_lastpage" content={p.pages.split('-')[1]} />}
    {p.doi && <meta name="citation_doi" content={p.doi} />}
    {pdfUrl && <meta name="citation_pdf_url" content={pdfUrl} />}
    <meta name="citation_language" content={p.lang} />
  </Fragment>

  <article>
    <header class="container narrow head">
      <a class="back" href="/research/" data-reveal>‹ 全部研究</a>
      <p class="eyebrow" data-reveal style="--d:60ms">{statusLabel}<span lang={p.lang}>{p.status === 'thesis' ? '山东师范大学' : p.venue} · {p.year}</span></p>
      <h1 lang={p.lang} data-reveal style="--d:120ms">{p.title}</h1>
      {p.titleEn && p.lang === 'zh' && <p class="en-title" lang="en" data-reveal style="--d:160ms">{p.titleEn}</p>}
      <p class="authors" lang={p.lang} data-reveal style="--d:200ms">
        {p.authors.map((a, i) => (
          <>{i > 0 && (p.lang === 'zh' ? '、' : ', ')}{site.selfNames.includes(a) ? <strong>{a}</strong> : a}</>
        ))}
      </p>
      <div class="actions" data-reveal style="--d:260ms">
        {p.doi && <a class="btn btn-primary" href={`https://doi.org/${p.doi}`} target="_blank" rel="noopener">查看原文 DOI</a>}
        {p.pdf && <a class="btn btn-secondary" href={p.pdf}>下载 PDF</a>}
        {p.url && <a class="btn btn-secondary" href={p.url} target="_blank" rel="noopener">链接</a>}
        <button class="btn btn-ghost" type="button" data-copy="cite-text">复制引用</button>
      </div>
    </header>

    {banner && (
      <div class="container banner-wrap">
        <div class="banner" data-zoom>
          <Image src={banner} alt="" widths={[800, 1400, 2000]} sizes="(max-width: 1120px) 100vw, 1060px" />
        </div>
      </div>
    )}

    <div class="container narrow body">
      <section class="block" data-reveal>
        <h2 class="block-title">摘要<span lang="en">Abstract</span></h2>
        <p class="abstract" lang={p.lang}>{p.abstract}</p>
        {p.keywords.length > 0 && <ul class="kw" lang={p.lang}>{p.keywords.map((k) => <li class="chip">{k}</li>)}</ul>}
      </section>

      <section class="block" data-reveal>
        <h2 class="block-title">引用<span lang="en">Cite</span></h2>
        <div class="cite card">
          <p id="cite-text" lang={p.lang}>{cite}</p>
          <button class="btn btn-ghost btn-sm" type="button" data-copy="cite-text">
            <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M16 8V6.5A2.5 2.5 0 0 0 13.5 4h-7A2.5 2.5 0 0 0 4 6.5v7A2.5 2.5 0 0 0 6.5 16H8" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
            复制
          </button>
        </div>
        <p class="cite-note">{p.lang === 'zh' ? 'GB/T 7714—2015 格式' : 'APA 第 7 版格式'}</p>
      </section>
    </div>
  </article>

  {others.length > 0 && (
    <section class="section alt more">
      <div class="container">
        <h2 class="title more-title" data-reveal>更多研究</h2>
        <div class="more-grid">
          {others.map((o, i) => (
            <a class="mcard card lift" href={`/research/${o.id}/`} data-reveal style={`--d:${i * 80}ms`}>
              <span class="m-year">{o.data.year} · {o.data.status === 'thesis' ? '学位论文' : o.data.venue}</span>
              <h3 lang={o.data.lang}>{o.data.title}</h3>
              <span class="link-arrow">阅读</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .head { padding-top: calc(var(--nav-h) + clamp(40px, 7vw, 88px)); text-align: center; }
  .back { display: inline-block; font-size: 14px; color: var(--text-2); margin-bottom: 28px; }
  h1 { margin-top: 14px; font-size: clamp(28px, 4.6vw, 48px); font-weight: 700; line-height: 1.3; text-wrap: balance; }
  h1:lang(en) { line-height: 1.15; letter-spacing: -0.03em; }
  .en-title { margin-top: 14px; font-size: clamp(16px, 1.8vw, 19px); color: var(--text-2); text-wrap: balance; }
  .authors { margin-top: 22px; font-size: 17px; color: var(--text-2); }
  .authors strong { color: var(--text); }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 32px; }

  .banner-wrap { margin-top: clamp(48px, 7vw, 80px); }
  .banner { overflow: hidden; border-radius: 40px; aspect-ratio: 21 / 9; box-shadow: var(--shadow-lg); will-change: transform; background: #111; }
  .banner :global(img) { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 640px) { .banner { aspect-ratio: 4 / 3; } }

  .body { padding-top: clamp(48px, 7vw, 80px); padding-bottom: clamp(64px, 9vw, 112px); }
  .block + .block { margin-top: 56px; }
  .block-title { font-size: 28px; font-weight: 700; letter-spacing: .06em; margin-bottom: 20px; }
  .block-title span { font-size: 17px; font-weight: 500; color: var(--text-3); margin-left: 12px; letter-spacing: 0; }
  .abstract { font-size: 18px; line-height: 1.85; color: var(--text); text-align: justify; }
  .abstract:lang(en) { text-align: left; }
  .kw { list-style: none; padding: 0; margin: 24px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .cite { display: flex; gap: 16px; align-items: flex-start; padding: 22px 24px; }
  .cite p { flex: 1; font-size: 15px; line-height: 1.7; overflow-wrap: anywhere; color: var(--text); }
  .cite-note { margin-top: 12px; font-size: 13px; color: var(--text-3); }
  @media (max-width: 560px) { .cite { flex-direction: column; } }

  .more-title { text-align: center; margin-bottom: 40px; }
  .more-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; }
  .mcard { display: flex; flex-direction: column; gap: 12px; padding: 28px; color: var(--text); text-decoration: none !important; }
  .m-year { font-size: 13px; color: var(--text-3); }
  .mcard h3 { font-size: 18px; line-height: 1.45; font-weight: 600; flex: 1; }
</style>
