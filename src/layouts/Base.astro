---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { site, nav, credits } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** 顶部是否叠在深色大图上（导航栏使用浅色文字直到滚动） */
  overlayNav?: boolean;
}
const { title, description = `${site.name} ${site.nameEn} · ${site.titleEn}`, overlayNav = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} ${site.nameEn}`;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const canonical = new URL(path, Astro.site);
---
<!doctype html>
<html lang="zh-CN" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#fbfbfd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <slot name="head" />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      try {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <header class:list={['nav', { 'on-dark': overlayNav }]} id="nav">
      <div class="nav-inner container">
        <a class="brand" href="/" aria-label="返回首页">
          <span class="logo" aria-hidden="true">苏</span>
          <span class="brand-name">{site.name}<span class="brand-en" lang="en">{site.nameEn}</span></span>
        </a>
        <nav class="links" aria-label="主导航">
          {nav.map((n) => (
            <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.zh}<span class="en" lang="en">{n.en}</span></a>
          ))}
        </nav>
        <div class="tools">
          <button class="icon-btn" id="theme-toggle" type="button" aria-label="切换深色模式">
            <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="currentColor"/><g stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"/></g></svg>
            <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M20.5 14.1A8.5 8.5 0 0 1 9.9 3.5a8.5 8.5 0 1 0 10.6 10.6Z"/></svg>
          </button>
          <button class="icon-btn burger" id="menu-toggle" type="button" aria-label="打开菜单" aria-expanded="false" aria-controls="mobile-menu">
            <span></span><span></span>
          </button>
        </div>
      </div>
    </header>
    <div class="mobile-menu" id="mobile-menu">
      <nav class="container" aria-label="移动端导航">
        {nav.map((n, i) => (
          <a href={n.href} style={`--i:${i}`} aria-current={isActive(n.href) ? 'page' : undefined}>{n.zh}<span lang="en">{n.en}</span></a>
        ))}
      </nav>
    </div>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        <div class="foot-top">
          <div>
            <p class="foot-name">{site.name} <span lang="en">{site.nameEn}</span></p>
            <p class="foot-tag">{site.tagline}</p>
          </div>
          <nav class="foot-links" aria-label="页脚导航">
            {nav.map((n) => <a href={n.href}>{n.zh}</a>)}
            <a href={`mailto:${site.email}`}>邮箱</a>
          </nav>
        </div>
        <div class="foot-bottom">
          <p lang="en">© {new Date().getFullYear()} {site.nameEn}. All rights reserved.</p>
          <p class="credits">
            图片：{credits.map((c, i) => <>{i > 0 && '、'}<a href={c.href} target="_blank" rel="noopener">{c.who}</a></>)} / <span lang="en">Unsplash</span>
          </p>
        </div>
      </div>
    </footer>

    <script>
      import { init, applyTheme } from '../scripts/interactions';
      document.addEventListener('astro:after-swap', applyTheme);
      document.addEventListener('astro:page-load', init);
    </script>
  </body>
</html>

<style>
  /* ---------- 导航栏 ---------- */
  .nav {
    position: fixed; inset: 0 0 auto 0; z-index: 100; height: var(--nav-h);
    background: var(--glass);
    backdrop-filter: saturate(180%) blur(20px); -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid transparent;
    transition: background-color .4s var(--ease), border-color .4s var(--ease), color .4s var(--ease);
  }
  :global(.nav.scrolled) { border-bottom-color: var(--line); }
  :global(.nav.on-dark:not(.scrolled):not(.open)) { background: transparent; color: #fff; }
  :global(.nav.on-dark:not(.scrolled):not(.open)) .links a,
  :global(.nav.on-dark:not(.scrolled):not(.open)) .brand,
  :global(.nav.on-dark:not(.scrolled):not(.open)) .icon-btn { color: rgba(255,255,255,.92); }
  :global(.nav.on-dark:not(.scrolled):not(.open)) .brand-en,
  :global(.nav.on-dark:not(.scrolled):not(.open)) .links .en { color: rgba(255,255,255,.6); }
  :global(.nav.on-dark:not(.scrolled):not(.open)) .burger span { background: #fff; }

  .nav-inner { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .brand { display: flex; align-items: center; gap: 10px; color: var(--text); text-decoration: none !important; transition: color .3s; }
  .logo {
    display: grid; place-items: center; width: 28px; height: 28px; border-radius: 8px;
    background: linear-gradient(135deg, #c7000b, #ff4d2e); color: #fff; font-size: 15px; font-weight: 700;
  }
  .brand-name { font-size: 15px; font-weight: 600; letter-spacing: .08em; display: flex; align-items: baseline; gap: 8px; }
  .brand-en { font-size: 12px; font-weight: 500; color: var(--text-3); letter-spacing: 0; }

  .links { display: flex; gap: 4px; }
  .links a {
    position: relative; padding: 6px 14px; border-radius: 999px; font-size: 14px; color: var(--text);
    opacity: .8; text-decoration: none !important; transition: opacity .2s, background-color .2s, color .3s;
    display: flex; align-items: baseline; gap: 6px;
  }
  .links a:hover { opacity: 1; }
  .links a[aria-current="page"] { opacity: 1; font-weight: 600; }
  .links a[aria-current="page"]::after {
    content: ""; position: absolute; left: 50%; bottom: -1px; width: 4px; height: 4px; margin-left: -2px;
    border-radius: 50%; background: var(--accent);
  }
  .links .en { font-size: 11px; color: var(--text-3); font-weight: 400; }

  .tools { display: flex; align-items: center; gap: 4px; }
  .icon-btn {
    display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%;
    border: 0; background: transparent; color: var(--text); cursor: pointer; transition: background-color .2s, color .3s;
  }
  .icon-btn:hover { background: var(--line); }
  .moon { display: none; }
  :global([data-theme="dark"]) .sun { display: none; }
  :global([data-theme="dark"]) .moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .sun { display: none; }
    :global(:root:not([data-theme="light"])) .moon { display: block; }
  }

  .burger { display: none; position: relative; }
  .burger span {
    position: absolute; left: 10px; width: 16px; height: 1.5px; border-radius: 2px; background: var(--text);
    transition: transform .4s var(--ease-out), top .4s var(--ease-out), background-color .3s;
  }
  .burger span:first-child { top: 14px; }
  .burger span:last-child { top: 21px; }
  :global(.nav.open) .burger span:first-child { top: 17.5px; transform: rotate(45deg); }
  :global(.nav.open) .burger span:last-child { top: 17.5px; transform: rotate(-45deg); }

  .mobile-menu {
    position: fixed; inset: var(--nav-h) 0 0 0; z-index: 99; background: var(--bg); overflow-y: auto;
    opacity: 0; visibility: hidden; transition: opacity .35s var(--ease), visibility .35s;
  }
  .mobile-menu nav { display: flex; flex-direction: column; padding-top: 24px; }
  .mobile-menu a {
    display: flex; align-items: baseline; justify-content: space-between;
    padding: 14px 0; font-size: 28px; font-weight: 600; color: var(--text); letter-spacing: .06em;
    border-bottom: 1px solid var(--line); text-decoration: none !important;
    opacity: 0; transform: translateY(-12px);
    transition: opacity .5s var(--ease-out), transform .5s var(--ease-out);
    transition-delay: calc(var(--i) * 50ms);
  }
  .mobile-menu a span { font-size: 15px; font-weight: 500; color: var(--text-3); }
  .mobile-menu a[aria-current="page"] { color: var(--accent-text); }
  :global(.nav.open) + .mobile-menu { opacity: 1; visibility: visible; }
  :global(.nav.open) + .mobile-menu a { opacity: 1; transform: none; }

  @media (max-width: 760px) {
    .links { display: none; }
    .burger { display: grid; }
    .brand-en { display: none; }
  }
  @media (min-width: 761px) { .mobile-menu { display: none; } }

  /* ---------- 页脚 ---------- */
  .footer { background: var(--bg-alt); border-top: 1px solid var(--line); font-size: 13px; color: var(--text-2); }
  .foot-top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 24px; padding: 48px 0 28px; border-bottom: 1px solid var(--line); }
  .foot-name { font-size: 17px; font-weight: 600; color: var(--text); }
  .foot-name span { font-weight: 500; color: var(--text-3); margin-left: 6px; }
  .foot-tag { margin-top: 6px; }
  .foot-links { display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: center; }
  .foot-links a { color: var(--text-2); }
  .foot-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; padding: 20px 0 32px; color: var(--text-3); }
  .credits a { color: var(--text-3); text-decoration: underline; text-decoration-color: var(--line-strong); }
</style>
